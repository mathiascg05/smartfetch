{
  "name": "@mathiascg05/smartfetch",
  "version": "2.0.0",
  "description": "A resilient, zero-dependency TypeScript wrapper around the native fetch API: timeouts, retries with pluggable backoff, interceptors and typed errors.",
  "keywords": [
    "fetch",
    "http",
    "client",
    "retry",
    "backoff",
    "timeout",
    "interceptors",
    "abortcontroller",
    "typescript",
    "esm",
    "cjs",
    "zero-dependencies"
  ],
  "license": "MIT",
  "author": "Mathias Carstens <152658894+mathiascg05@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mathiascg05/smartfetch.git"
  },
  "homepage": "https://github.com/mathiascg05/smartfetch#readme",
  "bugs": {
    "url": "https://github.com/mathiascg05/smartfetch/issues"
  },
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.es.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run check:pack && npm run size",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "example": "tsx example.ts",
    "typecheck": "tsc --noEmit",
    "check:pack": "publint && attw --pack",
    "size": "size-limit",
    "docs": "typedoc",
    "mutation": "NODE_OPTIONS=--experimental-vm-modules stryker run"
  },
  "size-limit": [
    {
      "name": "ESM entry (gzip)",
      "path": "dist/index.js",
      "limit": "4 KB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "size-limit": "^11.2.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=18"
  }
}
