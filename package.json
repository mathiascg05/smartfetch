{
  "name": "smartfetch",
  "version": "1.0.0",
  "description": "Wrapper avanzado y resiliente sobre la API nativa fetch, sin dependencias de terceros.",
  "keywords": [
    "fetch",
    "http",
    "client",
    "retry",
    "timeout",
    "interceptors",
    "typescript"
  ],
  "license": "MIT",
  "author": "Mathias Carstens <152658894+mathiascg05@users.noreply.github.com>",
  "contributors": [
    "sjrisquez <182248928+sjrisquez@users.noreply.github.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mathiascg05/smartfetch.git"
  },
  "homepage": "https://github.com/mathiascg05/smartfetch#readme",
  "bugs": {
    "url": "https://github.com/mathiascg05/smartfetch/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "example": "tsx example.ts",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
